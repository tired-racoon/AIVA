# .env
LLM_PROVIDER=local
MUSIC_PROVIDER=yandex
SEARCH_PROVIDER=duckduckgo
STREAMING_ENABLED=true

LOCAL_MODEL_NAME=Qwen/Qwen3-0.6B
LOCAL_DEVICE_MAP=auto

YANDEX_API_KEY=your_key_here
YANDEX_FOLDER_ID=your_folder_id
YANDEX_MODEL=gpt-oss-20b

OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_PROXY_URL=http://your-proxy:port

YANDEX_MUSIC_TOKEN=your_token_here

TTS_SPEAKER_ID=2
TTS_MODEL_NAME=vosk-model-tts-ru-0.9-multi

ACTIVATION_PHRASE=айва
SILENCE_THRESHOLD=500
SILENCE_DURATION=1.5
MIN_FREQUENCY=300
MAX_FREQUENCY=3400
BUFFER_DURATION=2.0

LOG_LEVEL=INFO
LOG_FILE=assistant.log

MAX_TOKENS=512
TEMPERATURE=0.7